QDRANT_API_KEY=<key>
QDRANT_URL=https://<url>.us-east4-0.gcp.cloud.qdrant.io:6334

# JWT Authentication (required for session persistence)
# Must be at least 32 characters for security
JWT_SECRET=your-secret-key-here-minimum-32-characters-required

# Anthropic Configuration (default provider - recommended)
ANTHROPIC_API_KEY=<key>
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_ORG_ID=<id>
ANTHROPIC_ADMIN_API_KEY=<key>

# OpenAI Configuration (optional - alternative to Anthropic)
# Uncomment to use OpenAI as provider instead of Anthropic
# OPENAI_API_KEY=sk-<key>
# OPENAI_MODEL=gpt-4o

GOOGLE_TTS_API_KEY=<key>
ELEVEN_LABS_API_KEY=<key>
ELEVEN_LABS_MODEL=eleven_multilingual_v2
ELEVEN_LABS_URL=https://api.elevenlabs.io/v1/
AZURE_SPEECH_KEY=<key>
AZURE_SPEECH_REGION=eastus

# AI Provider Configuration
# Default: anthropic (if not specified, defaults to anthropic)
# Allowed values: anthropic, openai
# Each channel can use a different provider independently

# Response Channel (generates AI responses to user messages)
RESPONSE_PROVIDER=anthropic
RESPONSE_MODEL=
RESPONSE_API_KEY=

# Learning Channel (generates learning exercises and explanations)
LEARNING_PROVIDER=anthropic
LEARNING_MODEL=
LEARNING_API_KEY=

# Analysis Channel (analyzes user performance and progress)
ANALYSIS_PROVIDER=anthropic
ANALYSIS_MODEL=
ANALYSIS_API_KEY=
