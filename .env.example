# Secrets only - non-sensitive config is in config.yaml

# Qdrant Vector Store
QDRANT_API_KEY=<key>

# JWT Authentication (minimum 32 characters)
JWT_SECRET=your-secret-key-here-minimum-32-characters-required

# Anthropic API
ANTHROPIC_API_KEY=<key>
ANTHROPIC_ADMIN_API_KEY=<key>

# OpenAI API (optional - alternative to Anthropic)
# OPENAI_API_KEY=sk-<key>

# TTS Providers
ELEVEN_LABS_API_KEY=<key>
AZURE_SPEECH_KEY=<key>

# Admin
ADMIN_TOKEN=<token>

# Database (PostgreSQL - optional, default is Sled file DB)
# DATABASE_URL=postgres://user:pass@localhost/dialect_coach

# Per-channel API key overrides (optional)
# RESPONSE_API_KEY=
# LEARNING_API_KEY=
# ANALYSIS_API_KEY=
# PRONUNCIATION_API_KEY=
# PLANNING_API_KEY=
